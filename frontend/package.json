{
  "name": "frontend-monorepo",
  "private": true,
  "workspaces": [
    "common",
    "web",
    "vsc"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev:web": "npm --workspace @agentflow/web run dev",
    "build:prebuilt": "rm -rf ../src/agentflow/server/prebuilt && npm --workspace @agentflow/web run build -- --outDir ../../src/agentflow/server/prebuilt"
  }
}
